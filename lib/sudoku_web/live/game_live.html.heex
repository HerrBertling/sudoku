<div class="flex flex-col items-center gap-4 py-4 h-[calc(100vh-4rem)]" phx-window-keydown="keydown">
  <h1 class="text-3xl font-bold shrink-0">Sudoku</h1>

  <div :if={@board.status == :complete} class="alert alert-success w-auto shrink-0">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="stroke-current shrink-0 h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
      />
    </svg>
    <span class="text-lg font-semibold">Puzzle Complete!</span>
  </div>

  <div class="flex-1 min-h-0 w-full flex items-center justify-center">
    <div class="grid grid-cols-9 border-2 border-base-content rounded aspect-square max-h-full max-w-full h-full w-auto">
      <div
        :for={cell <- @board.cells}
        class={cell_classes(cell, @board)}
        phx-click="select_cell"
        phx-value-row={cell.row}
        phx-value-col={cell.col}
      >
        <span :if={cell.value} class="text-[clamp(0.75rem,3cqi,2rem)]">{cell.value}</span>
        <div :if={!cell.value} class="grid grid-cols-3 w-full h-full">
          <% pencil_marks = candidates(cell, @board) %>
          <span
            :for={n <- 1..9}
            class="flex items-center justify-center text-[clamp(0.3rem,1.2cqi,0.7rem)] leading-none text-base-content/40"
          >
            {if n in pencil_marks, do: n}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex gap-2 shrink-0">
    <button
      :for={n <- 1..9}
      class="btn btn-sm btn-outline min-w-[2.5rem]"
      phx-click="place_number"
      phx-value-number={n}
    >
      {n}
    </button>
    <button class="btn btn-sm btn-ghost" phx-click="place_number" phx-value-number="clear">
      Clear
    </button>
  </div>

  <div class="flex gap-2 shrink-0">
    <button
      :for={d <- [:easy, :medium, :hard]}
      class="btn btn-outline btn-sm"
      phx-click="new_game"
      phx-value-difficulty={d}
    >
      New {d |> to_string() |> String.capitalize()}
    </button>
  </div>

  <p class="text-sm text-base-content/60 shrink-0">
    Click a cell, then use number buttons or keyboard (1-9, Backspace to clear)
  </p>
</div>
