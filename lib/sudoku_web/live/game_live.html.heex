<div id="sudoku-game" phx-hook="BoardPersistence" class="flex flex-col items-center gap-4 py-4 h-[calc(100vh-4rem)]" phx-window-keydown="keydown">
  <h1 class="text-3xl font-bold shrink-0">Sudoku</h1>

  <div :if={@board.status == :complete} class="alert alert-success w-auto shrink-0">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="stroke-current shrink-0 h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
      />
    </svg>
    <span class="text-lg font-semibold">Puzzle Complete!</span>
  </div>

  <div class="flex-1 min-h-0 w-full flex items-center justify-center">
    <% blocked = blocked_cells_for(@highlighted_number, @board, @excluded_candidates) %>
    <div class="grid grid-cols-9 border-2 border-base-content rounded aspect-square max-h-full max-w-full h-full w-auto">
      <div
        :for={cell <- @board.cells}
        class={cell_classes(cell, @board, blocked)}
        phx-click="select_cell"
        phx-value-row={cell.row}
        phx-value-col={cell.col}
      >
        <span :if={cell.value} class="text-[clamp(0.75rem,3cqi,2rem)]">{cell.value}</span>
        <div :if={!cell.value} class="grid grid-cols-3 w-full h-full">
          <% {possible, _pencil_marks} = cell_candidates(cell, @board, @excluded_candidates) %>
          <%= for n <- 1..9 do %>
            <%= if n in possible do %>
              <span
                class={[
                  "flex items-center justify-center text-[clamp(0.3rem,1.2cqi,0.7rem)] leading-none cursor-pointer hover:bg-base-300/50 rounded-sm",
                  if(excluded?(cell, n, @excluded_candidates), do: "text-base-content/15 line-through", else: "text-base-content/40")
                ]}
                phx-click="toggle_candidate"
                phx-value-row={cell.row}
                phx-value-col={cell.col}
                phx-value-number={n}
              >
                {n}
              </span>
            <% else %>
              <span class="flex items-center justify-center text-transparent text-[clamp(0.3rem,1.2cqi,0.7rem)] leading-none">
                {n}
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex gap-2 shrink-0 items-center">
    <button
      :for={n <- 1..9}
      class={[
        "btn btn-sm min-w-[2.5rem]",
        if(@highlighted_number == n, do: "btn-warning", else: "btn-outline")
      ]}
      phx-click="toggle_highlight"
      phx-value-number={n}
    >
      {n}
    </button>
  </div>

  <div class="flex gap-2 shrink-0">
    <button
      :for={d <- [:easy, :medium, :hard]}
      class="btn btn-outline btn-sm"
      phx-click="new_game"
      phx-value-difficulty={d}
    >
      New {d |> to_string() |> String.capitalize()}
    </button>
  </div>

  <p class="text-sm text-base-content/60 shrink-0">
    Click a cell, then use keyboard (1-9, Backspace to clear). Number buttons highlight blocked areas.
  </p>
</div>
